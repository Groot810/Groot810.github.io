      { "id": "headphones-studio", "kind": "image", "title": "图片6", "x": 170, "y": 466, "width": 300, "content": "生成一个背景为冷调影棚，场景内放着一个灰色简约的中性沙发", "version": 1, "createdAt": 7, "imageWidth": 1024, "imageHeight": 1024, "imageAutoSize": true, "imageCount": 1 },
