      { "id": "outdoor-jacket-commerce-display", "kind": "image", "title": "电商平面展示图", "x": 501, "y": 410, "width": 300, "content": "", "version": 1, "createdAt": 1, "imageWidth": 1024, "imageHeight": 1024, "imageAutoSize": true, "imageCount": 1 },
      { "id": "outdoor-jacket-image-2", "kind": "image", "title": "参考图片2", "x": 951, "y": 410, "width": 300, "content": "", "version": 1, "createdAt": 2, "imageWidth": 1024, "imageHeight": 1024, "imageAutoSize": true, "imageCount": 1 },
      { "id": "outdoor-jacket-video-1", "kind": "video", "title": "视频素材1", "x": 1401, "y": 410, "width": 300, "content": "", "version": 1, "createdAt": 3, "videoAspectWidth": 16, "videoAspectHeight": 9, "videoAutoSize": true, "videoDuration": 5, "videoResolution": 720 },
      { "id": "outdoor-jacket-reference-3", "kind": "image", "title": "参考图片3", "x": 501, "y": 831, "width": 300, "content": "", "version": 1, "createdAt": 4, "imageWidth": 1024, "imageHeight": 1024, "imageAutoSize": true, "imageCount": 1 },
      { "id": "outdoor-jacket-model-scene", "kind": "image", "title": "参考图片4", "x": 951, "y": 831, "width": 300, "content": "年轻东亚女性，身材纤细腰腹紧致，棕黑色长直长发，正视镜头面带淡笑；右手握登山杖，左手搭背包肩带，行走姿态放松；户外伪素颜淡妆，干净清透底妆，自然淡裸唇；橘色jeep品牌宽松连帽外套，胸口品牌logo，黑色工装裤，背黑色轻量化徒步单肩背包，脚穿棕色户外徒步鞋；户外郊野林间场景，高大乔木树干，深绿山林背景，山涧溪流灰色湿润岩石；林间柔和自然散射光，光线均匀阴影柔和；全画幅相机拍摄，50mm定焦镜头，f/2.8-f/4光圈，画质清晰细腻；竖版3:4比例，全身人像构图，人物中心构图，层次清晰主体突出；松弛户外氛围感，清新治愈山野风，色彩明快饱和度适中", "version": 1, "createdAt": 5, "imageWidth": 1024, "imageHeight": 1024, "imageAutoSize": true, "imageCount": 1 },
